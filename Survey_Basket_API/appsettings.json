{
  "ConnectionStrings": {
    "DefaultConnection": "server =(localdb)\\MSSQLLocalDB;Database= Survay Basket;Trusted_Connection=true;Encrypt =false",
    "HangfireConnection": "server =(localdb)\\MSSQLLocalDB;Database= SurveyBasketJobs;Trusted_Connection=true;Encrypt =false"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Logs\\log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext","WithMachineName","WithThreadId"],
    "Properties": {"ApplicationName": "SurvayBasket"}
  
},
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "surveyBasketApp",
    "Audience": "surveyBasketUsers",
    "ExpireMinutes": 30
  },
  "AllowedOrigins": [
    "https://Survay-Basket.com"
  ],
  "MailSettings": {
    "Mail": "gisselle.jaskolski@ethereal.email",
    "DisplayName": "Survey Basket",
    "Password": "",
    "Host": "smtp.ethereal.email",
    "Port": "587"
  },
  "HangfireSettings": {
    "Username": "",
    "password": ""
  }
}
